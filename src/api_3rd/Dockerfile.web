# Image phục vụ index.html — trang thao tác tay (chụp/tải ảnh) gọi sang API
# qc-scanner thật QUA REVERSE PROXY của chính nginx này (xem nginx.web.conf).
# KHÔNG đóng gói API ở đây; xem Dockerfile + docker-compose.yml cho API.
#
# Lý do có proxy thay vì để index.html gọi thẳng IP API: trang này chạy sau
# HTTPS trong khi API chỉ có HTTP thuần — gọi thẳng bị trình duyệt chặn vì
# "mixed content". Đổi IP/port của API thật thì sửa `proxy_pass` trong
# nginx.web.conf rồi build lại image này.
FROM nginx:alpine

COPY index.html /usr/share/nginx/html/index.html
COPY config.js.template /usr/share/nginx/html/config.js.template
COPY nginx.web.conf /etc/nginx/conf.d/default.conf

# Sinh /usr/share/nginx/html/config.js (chứa API key thật) từ
# config.js.template lúc container khởi động, KHÔNG lúc build image - key
# đọc từ biến môi trường QC_SCANNER_API_KEY của container (xem
# docker-compose.web.yml), nên không bao giờ nằm trong layer image hay
# trong git. Ảnh nginx:alpine tự chạy mọi script thực thi trong
# /docker-entrypoint.d/ trước khi khởi động nginx - không cần đổi ENTRYPOINT.
COPY docker-entrypoint.d/40-inject-api-key.sh /docker-entrypoint.d/40-inject-api-key.sh
RUN chmod +x /docker-entrypoint.d/40-inject-api-key.sh

EXPOSE 80
