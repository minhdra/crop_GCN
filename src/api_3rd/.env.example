# Sao chép file này thành `.env` (cùng thư mục) rồi điền key thật:
#   cp .env.example .env
#
# docker compose tự nạp `.env` khi chạy `docker compose -f docker-compose.web.yml up`.
# `.env` bị .gitignore chặn ở gốc repo (pattern ".env") - không commit lên git.

# Key của client "app-web", cấp bởi người vận hành QC Scanner API thật (xem
# qc_scanner/docs/api.md §2 - Xác thực). Container dừng ngay lúc khởi động
# nếu biến này thiếu hoặc rỗng (xem docker-compose.web.yml).
QC_SCANNER_API_KEY=qcs-...
