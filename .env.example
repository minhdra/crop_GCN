# ============================================================================
# Document Scanner API - biến môi trường cấu hình
#
# Sao chép file này thành `.env` rồi chỉnh giá trị theo môi trường thực tế:
#   cp .env.example .env
#
# `.env` được:
#   - `docker compose` tự nạp vào container (xem `env_file` trong docker-compose.yml)
#   - app tự nạp khi chạy trực tiếp (uvicorn/scan-api) nhờ python-dotenv,
#     KHÔNG ghi đè lên biến môi trường đã export sẵn trong shell.
#
# Không có biến nào chứa thông tin nhạy cảm (API hiện không có auth) - an
# toàn để dùng giá trị mặc định cho môi trường dev/test.
# ============================================================================


# ---- Lưu trữ file ----

# Thư mục lưu lâu dài bản sao kết quả scan để đối soát nhanh trên ổ đĩa,
# ngoài luồng gọi API (xem _persist_output_copy trong api.py).
# Nếu bỏ trống: mặc định <thư mục dự án>/output_scans khi chạy local.
# Trong Docker được đặt là /app/output_scans (xem docker-compose.yml) -
# không cần khai báo lại ở đây trừ khi muốn đổi đường dẫn local.
# SCAN_OUTPUT_DIR=./output_scans


# ---- Dọn dẹp tự động ----
# Không dọn tự động sẽ khiến cả thư mục file tạm lẫn SCAN_OUTPUT_DIR phình
# to vô hạn theo thời gian server chạy.

# Số giờ giữ lại file/job xử lý tạm (dùng để phục vụ /api/download,
# /api/view, /api/debug ngay sau khi scan) trước khi tự động xóa. Người
# dùng thường tải kết quả ngay sau khi scan nên không cần giữ quá lâu.
SCAN_STORAGE_TTL_HOURS=5

# Số ngày giữ lại bản sao kết quả lâu dài trong SCAN_OUTPUT_DIR trước khi
# tự động xóa. Tăng lên nếu nghiệp vụ cần đối soát/tra cứu lại lâu hơn.
SCAN_OUTPUT_TTL_DAYS=1

# Tần suất (phút) chạy lại lượt dọn file hết hạn trong lúc server đang
# chạy, ngoài lượt dọn chạy ngay lúc khởi động. Giảm xuống nếu tốc độ sinh
# file nhanh và cần dọn sát sao hơn.
SCAN_CLEANUP_INTERVAL_MINUTES=30


# ---- Chịu tải / giới hạn tài nguyên ----
# Xem thêm mục "Performance / khả năng chịu tải" trong README.md.

# Số uvicorn worker process (multi-process). Workload OpenCV/PyMuPDF là
# CPU-bound và bị giới hạn bởi GIL nếu chỉ chạy 1 process - multi-process
# mới tận dụng được nhiều CPU core. Nên đặt bằng số CPU core cấp cho
# container/máy chủ.
# LƯU Ý: chỉ có hiệu lực khi chạy qua Docker/uvicorn CLI với --workers
# (xem CMD trong Dockerfile); lệnh `scan-api` (gọi hàm run() cho dev cục
# bộ) luôn chạy 1 process, không đọc biến này.
# Nên đặt = số core CPU thực sự cấp cho container (xem cpus trong
# docker-compose.yml) - ví dụ dưới đây khớp ngân sách 4 core.
WEB_CONCURRENCY=4

# Số job xử lý (scan_image/scan_pdf) đồng thời tối đa TRÊN MỖI worker
# process. Vượt quá số này, request mới CHỜ (xếp hàng) tối đa
# SCAN_QUEUE_TIMEOUT_SECONDS cho có slot trống thay vì bị từ chối ngay.
# Tổng số job đồng thời thực tế toàn server ≈ WEB_CONCURRENCY × SCAN_MAX_CONCURRENT_JOBS.
# Nên để 1: mỗi worker xử lý 1 job CPU-bound tại một thời điểm, để tổng job
# đồng thời = WEB_CONCURRENCY = đúng số core được cấp, tránh vừa tranh chấp
# CPU vừa tranh chấp GIL trong cùng 1 process khi chạy nhiều job song song.
SCAN_MAX_CONCURRENT_JOBS=1

# Nếu client gọi vào KHÔNG tự động retry khi gặp 503, request vượt quá
# SCAN_MAX_CONCURRENT_JOBS sẽ CHỜ tối đa số giây này để có slot trống thay
# vì bị từ chối ngay, chỉ trả 503 (kèm Retry-After) nếu chờ quá lâu. Nên
# đặt nhỏ hơn timeout phía client.
SCAN_QUEUE_TIMEOUT_SECONDS=20

# Số request tối đa được giữ chờ cùng lúc trên MỖI worker process (đa số
# chỉ đang chờ SCAN_MAX_CONCURRENT_JOBS, gần như không tốn CPU). Nên lớn
# hơn hẳn burst tối đa dự kiến từ client để không bị nghẽn ở tầng
# threadpool (nơi KHÔNG áp dụng SCAN_QUEUE_TIMEOUT_SECONDS).
SCAN_MAX_QUEUED_REQUESTS=40

# Kích thước file upload tối đa (MB) cho mỗi file PDF/ảnh. Chặn sớm trước
# khi tốn CPU xử lý file quá khổ.
SCAN_MAX_UPLOAD_MB=50

# Số thread nội bộ OpenCV dùng cho MỖI job xử lý (cv2.setNumThreads). Mặc
# định OpenCV tự chiếm nhiều thread theo số core phát hiện được, nhân với
# WEB_CONCURRENCY * SCAN_MAX_CONCURRENT_JOBS job chạy song song sẽ gây
# tranh chấp CPU (oversubscription) và làm chậm hẳn khi có tải đồng thời.
# Để 1 (mặc định) cho đúng nguyên tắc: mỗi job 1 core, chạy song song ở
# tầng process/threadpool thay vì để OpenCV tự nhân song song bên trong.
CV2_NUM_THREADS=1
